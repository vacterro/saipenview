# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/
# Nuitka leaves these three beside the project root
*.build/
*.onefile-build/

# Project runtime data
saipenview/_data/

# Session / agent data — machine-local paths, session state. INTENTIONALLY
# local-only by written contract (docs/saipen-persistence.md, T-172): the
# canonical memory travels via tools/export_source.py, never via git.
.saipen/*
.freebuff/
# Release-authority exception (T-832 ship convergence): the source-receipt
# intake/archive surface and the per-ticket release scope record are release
# metadata (docs/saipen-persistence.md, "Authority receipts" section) — the
# release executor must be able to commit them on ship so a fresh clone
# carries the authoritative source scope. Everything else under .saipen/
# stays machine-local.
!.saipen/intake/
!.saipen/archive/
!.saipen/kitchen/
.saipen/kitchen/*
!.saipen/kitchen/release_scope/
# Release-closure exception (T-832/T-833 ship convergence): the closure commit
# must carry the canonical memory (STATE/BOARD/LOG + sealed log segments +
# digest + published release receipt) so a fresh clone at the release tag can
# run recovery and prove the release (docs/saipen-persistence.md, "Closure
# travel" section).
!.saipen/STATE.md
!.saipen/BOARD.md
!.saipen/LOG.md
!.saipen/logs/
!.saipen/logs/**
!.saipen/kitchen/digest.md
!.saipen/kitchen/release_receipt.json
# The own-`.saipen` CI snapshot is TRACKED by deliberate exception (repair
# mission P1): CI cannot validate the gitignored live memory, so it validates
# this sanitized, mechanically-generated fixture instead. Regenerate with
# tools/snapshot_saipen.py --write.
!tests/fixtures/own_saipen_snapshot/.saipen/
!tests/fixtures/own_saipen_snapshot/.saipen/**

# Test artifacts
.pytest_cache/
.coverage
*.cover
.coverage.*
snap_test_log.txt
run_console_test*.log

# Package manager locks (optional, user-generated)
uv.lock

# Temp / swap
*.tmp
*.bak
# Wintage's installer parks a superseded style.css.bak here when it refreshes one
*.bak.stale
*.swp
.DS_Store
Thumbs.db

# Windows special devices
nul
NUL
NUL.*


# Executables
*.exe
*.dist/
crash.log
saipenview/ui/static/index.lite.html
