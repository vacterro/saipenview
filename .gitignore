# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/
# Nuitka leaves these three beside the project root
*.build/
*.onefile-build/

# Project runtime data
saipenview/_data/

# Session / agent data — machine-local paths, session state. INTENTIONALLY
# local-only by written contract (docs/saipen-persistence.md, T-172): the
# canonical memory travels via tools/export_source.py, never via git.
.saipen/
.freebuff/

# Test artifacts
.pytest_cache/
.coverage
*.cover
.coverage.*
snap_test_log.txt
run_console_test*.log

# Package manager locks (optional, user-generated)
uv.lock

# Temp / swap
*.tmp
*.bak
# Wintage's installer parks a superseded style.css.bak here when it refreshes one
*.bak.stale
*.swp
.DS_Store
Thumbs.db

# Windows special devices
nul
NUL
NUL.*


# Executables
*.exe
*.dist/
crash.log
